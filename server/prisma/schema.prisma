model tipos_equipo {
  id                  Int       @id @default(autoincrement())
  nombre_tipo         String    @unique(map: "nombre_tipo") @db.VarChar(100)
  descripcion         String?   @db.Text
  fecha_registro      DateTime? @default(now()) @db.Timestamp(0)
  fecha_actualizacion DateTime? @default(now()) @db.Timestamp(0)
  equipos             equipos[]
}

model tipos_sucursal {
  id          Int          @id @default(autoincrement())
  nombre_tipo String       @unique(map: "nombre_tipo") @db.VarChar(50)
  descripcion String?      @db.VarChar(255)
  sucursales  sucursales[]
}

model usuarios_sistema {
  id                                                   Int                  @id @default(autoincrement())
  username                                             String               @unique(map: "username") @db.VarChar(50)
  email                                                String?              @unique(map: "email") @db.VarChar(100)
  nombres                                              String?              @db.VarChar(100)
  apellidos                                            String?              @db.VarChar(100)
  password_hash                                        String               @db.VarChar(255)
  reset_password_token                                 String?              @db.VarChar(255)
  reset_password_expires                               DateTime?            @db.DateTime(0)
  id_empleado                                          Int?                 @unique(map: "id_empleado")
  id_rol                                               Int
  fecha_registro                                       DateTime?            @default(now()) @db.Timestamp(0)
  fecha_ultimo_login                                   DateTime?            @db.Timestamp(0)
  fecha_actualizacion                                  DateTime?            @default(now()) @db.Timestamp(0)
  id_status                                            Int                  @default(1)
  logs_sistema                                         logs_sistema[]
  notas                                                notas[]
  ticket_comentarios                                   ticket_comentarios[]
  tickets_tickets_id_usuario_reportaTousuarios_sistema tickets[]            @relation("tickets_id_usuario_reportaTousuarios_sistema")
  tickets_tickets_id_asignado_aTousuarios_sistema      tickets[]            @relation("tickets_id_asignado_aTousuarios_sistema")
  empleados                                            empleados?           @relation(fields: [id_empleado], references: [id], map: "fk_usuarios_sistema_empleados")
  roles                                                roles                @relation(fields: [id_rol], references: [id], map: "fk_usuarios_sistema_roles")
  status                                               status               @relation(fields: [id_status], references: [id], map: "fk_usuarios_sistema_status")

  @@index([id_rol], map: "fk_usuarios_sistema_roles")
  @@index([id_status], map: "fk_usuarios_sistema_status")
}

enum logs_sistema_accion {
  CREATE
  UPDATE
  DELETE
}

enum mantenimiento_evidencias_tipo {
  ANTES
  DESPUES
  DIAGNOSTICO
}

enum mantenimiento_archivos_tipo_archivo {
  FOTO_ANTES
  FOTO_DESPUES
  DOCUMENTO
  FACTURA
}

enum tickets_tipo_falla {
  HARDWARE
  SOFTWARE
  RED
  IMPRESORA
  OTRO
}

enum tickets_prioridad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum tickets_estatus {
  ABIERTO
  EN_PROGRESO
  PENDIENTE
  RESUELTO
