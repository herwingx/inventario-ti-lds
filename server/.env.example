# ================================================
# 🔧 CONFIGURACIÓN PRINCIPAL (CAMBIAR IP)
# ================================================
# Cambiar por la IP de tu máquina para acceso desde la red
APP_URL=http://TU_IP/soporte
API_URL=http://TU_IP/soporte/api
PORT=3000
NODE_ENV=development

# ================================================
# 🗄️ CONFIGURACIÓN DE LA BASE DE DATOS
# ================================================
DB_HOST=TU_IP
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=inventario_soporte
DB_PORT=3306
DATABASE_URL="mysql://tu_usuario:tu_password@TU_IP:3306/inventario_soporte"

# ================================================
# 🔐 CONFIGURACIÓN JWT (Tokens de Autenticación)
# ================================================
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_jwt_secret_aqui
JWT_EXPIRE=24h

# ================================================
# 📧 CONFIGURACIÓN DE CORREO (Nodemailer)
# ================================================
# Si usas Gmail
# EMAIL_SERVICE=gmail
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# Configuración Genérica SMTP
EMAIL_HOST=smtp.tuservidor.com
EMAIL_PORT=587
EMAIL_SECURE=false # true para 465, false para otros puertos
EMAIL_USER=tu_email@dominio.com
EMAIL_PASS=tu_contraseña_de_aplicacion
EMAIL_FROM="Soporte TI <no-reply@dominio.com>"

# ================================================
# 🎫 NOTIFICACIONES DEL MÓDULO TICKETS
# ================================================
# Estrategia recomendada (anti-saturación):
# - false: NO enviar correos por cada comentario de chat
# - true: SÍ enviar correos por comentarios (solo usar en contingencia)
# Los correos transaccionales (creación/asignación/estatus) se mantienen activos.
TICKETS_EMAIL_COMMENTS=false
