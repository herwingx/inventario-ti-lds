# ================================================
# 🔧 CONFIGURACIÓN PRINCIPAL (CAMBIAR IP)
# ================================================
# Cambiar por la IP de tu máquina para acceso desde la red
APP_URL=http://TU_IP/soporte
API_URL=http://TU_IP/soporte/api
PORT=3000
NODE_ENV=development

# ================================================
# 🗄️ CONFIGURACIÓN DE LA BASE DE DATOS
# ================================================
DB_HOST=TU_IP
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=inventario_soporte
DB_PORT=3306

# ================================================
# 🔐 CONFIGURACIÓN JWT (Tokens de Autenticación)
# ================================================
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_jwt_secret_aqui
JWT_EXPIRE=24h
